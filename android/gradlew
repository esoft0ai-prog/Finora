#!/usr/bin/env sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ -f "$WRAPPER_JAR" ]; then
  exec java -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
fi
GRADLE_VERSION=9.4.1
CACHE_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/finora-bootstrap/gradle-$GRADLE_VERSION"
GRADLE_BIN="$CACHE_DIR/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  command -v curl >/dev/null 2>&1 || { echo 'curl is required for the first Gradle bootstrap.' >&2; exit 1; }
  command -v unzip >/dev/null 2>&1 || { echo 'unzip is required for the first Gradle bootstrap.' >&2; exit 1; }
  TMP_ZIP="${TMPDIR:-/tmp}/gradle-$GRADLE_VERSION-bin.zip"
  echo "Bootstrapping Gradle $GRADLE_VERSION..."
  curl -fL --retry 3 "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$TMP_ZIP"
  mkdir -p "$(dirname "$CACHE_DIR")"
  rm -rf "$CACHE_DIR"
  unzip -q "$TMP_ZIP" -d "$(dirname "$CACHE_DIR")"
  rm -f "$TMP_ZIP"
fi
exec "$GRADLE_BIN" -p "$APP_HOME" "$@"
